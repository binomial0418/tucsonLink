<?php
/**
 * ==========================================
 * 帳號密碼設定（機敏資料，勿提交至版本控制）
 * ==========================================
 * 複製此檔案為 credentials.php 並填入實際值
 */

// 登入帳號密碼（密碼需用 password_hash() 產生）
// 產生方式: php -r "echo password_hash('你的密碼', PASSWORD_DEFAULT);"
define('ADMIN_USERNAME', 'your_username');
define('ADMIN_PASSWORD_HASH', '$2y$10$...');  // password_hash() 輸出

// MQTT 連線設定
define('MQTT_HOST', '127.0.0.1');
define('MQTT_PORT', 1883);
define('MQTT_USER', 'mqtt_user');
define('MQTT_PASS', 'mqtt_password');
define('MQTT_TOPIC', 'your/mqtt/topic');
